# Kling API Credentials (REQUIRED)
KLING_ACCESS_KEY=your_access_key_here
KLING_SECRET_KEY=your_secret_key_here

# JWT Service URL (Optional - uses default if not set)
JWT_SERVICE_URL=https://kling-jwt-service-production.up.railway.app/generate-jwt

# Server Configuration (Optional)
PORT=8000
VIDEOS_DIR=/tmp/videos

